# Generated into ./Caddyfile by deploy/setup.sh (placeholders substituted).
# Automatic HTTPS via Let's Encrypt; one shared password for the whole group.
__SITE__ {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
	request_body {
		max_size 13MB
	}
	basic_auth {
		__USER__ __HASH__
	}
	reverse_proxy app:8787
}
